pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/ferminromero00/LDAP_TAREA'
            }
        }

        stage('Instalar Terraform') {
            steps {
                script {
                    // Descargar Terraform (en Windows usamos Invoke-WebRequest)
                    powershell '''
                    Invoke-WebRequest -Uri https://releases.hashicorp.com/terraform/1.6.0/terraform_1.6.0_windows_amd64.zip -OutFile terraform_1.6.0_windows_amd64.zip
                    Expand-Archive -Path terraform_1.6.0_windows_amd64.zip -DestinationPath terraform
                    '''

                    // Crear un directorio para los binarios si no existe
                    powershell '''
                    if (-not (Test-Path -Path "$env:USERPROFILE\\terraform_bin")) {
                        New-Item -ItemType Directory -Path "$env:USERPROFILE\\terraform_bin"
                    }
                    '''

                    // Mover el binario terraform al directorio creado
                    powershell '''
                    Move-Item -Path "terraform\\terraform.exe" -Destination "$env:USERPROFILE\\terraform_bin\\terraform.exe"
                    '''
                }
            }
        }

        stage('Inicializar Terraform') {
            steps {
                // Cambiar al directorio 'terraform' donde están los archivos .tf
                dir('terraform') {
                    powershell '$env:PATH="$env:USERPROFILE\\terraform_bin;$env:PATH"; terraform init'
                }
            }
        }

        stage('Planificar Terraform') {
            steps {
                // Cambiar al directorio 'terraform' donde están los archivos .tf
                dir('terraform') {
                    powershell '$env:PATH="$env:USERPROFILE\\terraform_bin;$env:PATH"; terraform plan'
                }
            }
        }

        stage('Aplicar Terraform') {
            steps {
                // Cambiar al directorio 'terraform' donde están los archivos .tf
                dir('terraform') {
                    powershell '$env:PATH="$env:USERPROFILE\\terraform_bin;$env:PATH"; terraform apply -auto-approve'
                }
            }
        }
    }
}
