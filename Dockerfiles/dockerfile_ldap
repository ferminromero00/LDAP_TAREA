FROM osixia/openldap:latest

# Configuración de LDAP
ENV LDAP_ORGANISATION="Ejemplo1" \
    LDAP_DOMAIN="ldap-server.work.gd" \
    LDAP_ADMIN_PASSWORD="admin"

# Actualizar repositorios y paquetes, instalar herramientas de LDAP y Apache
RUN sed -i '/security.debian.org/d' /etc/apt/sources.list && \
    sed -i '/buster-backports/d' /etc/apt/sources.list && \
    sed -i 's|http://deb.debian.org/debian|http://archive.debian.org/debian|g' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y ldap-utils apache2 apache2-utils

# Exponer los puertos de LDAP y Apache
EXPOSE 389 636 80

# Habilitar los módulos necesarios para la autenticación LDAP
RUN a2enmod auth_basic authnz_ldap ldap

# Configurar el Apache VirtualHost para proteger el directorio /protegido
RUN echo '<VirtualHost *:80>' > /etc/apache2/sites-available/000-default.conf
RUN echo '    ServerName 10.0.1.161' >> /etc/apache2/sites-available/000-default.conf
RUN echo '    DocumentRoot "/var/www/html"' >> /etc/apache2/sites-available/000-default.conf
RUN echo '    <Directory "/var/www/html">' >> /etc/apache2/sites-available/000-default.conf
RUN echo '        Require all granted' >> /etc/apache2/sites-available/000-default.conf
RUN echo '    </Directory>' >> /etc/apache2/sites-available/000-default.conf
RUN echo '    # Protegemos /protegido con autenticación LDAP' >> /etc/apache2/sites-available/000-default.conf
RUN echo '    <Location /protegido>' >> /etc/apache2/sites-available/000-default.conf
RUN echo '        AuthType Basic' >> /etc/apache2/sites-available/000-default.conf
RUN echo '        AuthName "LDAP Authentication"' >> /etc/apache2/sites-available/000-default.conf
RUN echo '        AuthBasicProvider ldap' >> /etc/apache2/sites-available/000-default.conf
RUN echo '        AuthLDAPURL "ldap://ldap-server.work.gd:389/ou=empleados,dc=ldap-server,dc=work,dc=gd?uid"' >> /etc/httpd/conf/httpd.conf
RUN echo '        AuthLDAPBindDN "cn=admin,dc=ldap-server,dc=work,dc=gd"' >> /etc/apache2/sites-available/000-default.conf
RUN echo '        AuthLDAPBindPassword "admin"' >> /etc/apache2/sites-available/000-default.conf
RUN echo '        Require valid-user' >> /etc/apache2/sites-available/000-default.conf
RUN echo '    </Location>' >> /etc/apache2/sites-available/000-default.conf
RUN echo '</VirtualHost>' >> /etc/apache2/sites-available/000-default.conf

# Habilitar el sitio de Apache
RUN a2ensite 000-default.conf

# Iniciar el servidor OpenLDAP y Apache
CMD service apache2 start && /container/tool/run